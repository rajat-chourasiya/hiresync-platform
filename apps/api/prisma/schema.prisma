generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                 String   @id @default(uuid())
  name               String
  planId             String?
  subscriptionStatus String   @default("trial")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  dataRegion         String?
  jobs               Job[]
  users              User[]

  @@map("organizations")
}

model User {
  id                    String       @id @default(uuid())
  orgId                 String
  email                 String       @unique
  passwordHash          String
  role                  String
  tokenVersion          Int          @default(0)
  refreshTokenHash      String?
  refreshTokenExpiresAt DateTime?
  lastLoginAt           DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  roles                 UserRole[]
  organization          Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id       String           @id @default(uuid())
  name     String           @unique
  resource String
  action   String
  roles    RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Job {
  id           String        @id @default(uuid())
  orgId        String
  title        String
  slug         String
  skills       String[]
  status       String        @default("draft")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  stages       String[]      @default([])
  applications Application[]
  organization Organization  @relation(fields: [orgId], references: [id])

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("jobs")
}

model CandidateProfile {
  id           String        @id @default(uuid())
  orgId        String
  name         String
  email        String
  phone        String?
  skills       String[]
  resumeUrl    String?
  createdAt    DateTime      @default(now())
  applications Application[]

  @@index([email])
  @@index([orgId])
  @@map("candidate_profiles")
}

model Application {
  id               String           @id @default(uuid())
  orgId            String
  jobId            String
  candidateId      String
  status           String           @default("applied")
  aiAnalysisStatus String           @default("queued")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  candidate        CandidateProfile @relation(fields: [candidateId], references: [id])
  job              Job              @relation(fields: [jobId], references: [id])
  aiResumeAnalysis AiResumeAnalysis?

  @@unique([jobId, candidateId])
  @@index([orgId])
  @@map("applications")
}

model OtpVerification {
  id          String    @id @default(uuid())
  email       String
  purpose     String
  otpHash     String
  expiresAt   DateTime
  attempts    Int       @default(0)
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())

  @@index([email, purpose])
  @@map("otp_verifications")
}

model Interview {
  id             String                 @id @default(uuid())
  jobId          String
  candidateId    String
  interviewerIds String[]
  scheduledStart DateTime
  scheduledEnd   DateTime
  roomId         String                 @unique
  status         String                 @default("scheduled")
  createdAt      DateTime               @default(now())
  orgId          String
  feedbacks      Feedback[]
  accessTokens   InterviewAccessToken[]
  room           InterviewRoom?

  @@index([orgId])
  @@index([jobId])
  @@index([scheduledStart])
  @@map("interviews")
}

model InterviewRoom {
  id             String    @id @default(uuid())
  interviewId    String    @unique
  participants   String[]
  activeTypistId String?
  recordingUrl   String?
  createdAt      DateTime  @default(now())
  interview      Interview @relation(fields: [interviewId], references: [id])

  @@map("interview_rooms")
}

model InterviewAccessToken {
  id          String    @id @default(uuid())
  interviewId String
  candidateId String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  interview   Interview @relation(fields: [interviewId], references: [id])

  @@index([interviewId])
  @@map("interview_access_tokens")
}

model ChatMessage {
  id         String   @id @default(uuid())
  roomId     String
  senderId   String
  senderType String
  message    String
  createdAt  DateTime @default(now())

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

model CodeSnapshot {
  id        String   @id @default(uuid())
  roomId    String
  userId    String
  language  String
  code      String
  revision  Int      @default(1)
  createdAt DateTime @default(now())

  @@index([roomId])
  @@map("code_snapshots")
}

model Feedback {
  id             String    @id @default(uuid())
  interviewId    String
  interviewerId  String
  scores         Json
  recommendation String?
  submittedAt    DateTime  @default(now())
  interview      Interview @relation(fields: [interviewId], references: [id])

  @@index([interviewId])
  @@map("feedbacks")
}

model AiResumeAnalysis {
  id            String   @id @default(uuid())
  orgId         String
  jobId         String
  candidateId   String
  applicationId String   @unique
  modelProvider String
  modelName     String
  promptVersion String
  score         Decimal? @db.Decimal(5, 2)
  confidence    Decimal? @db.Decimal(5, 2)
  matchedSkills String[]
  missingSkills String[]
  strengths     String[]
  risks         String[]
  reviewStatus  String   @default("pending")
  rawResponse   Json?
  candidateType          String?  
  totalExperienceYears   Decimal? @db.Decimal(4, 1)
  currentCompany         String?
  currentRole            String?
  currentTenureMonths    Int?
  hasInternship          Boolean  @default(false)
  createdAt     DateTime @default(now())

  application   Application @relation(fields: [applicationId], references: [id])

  @@index([orgId])
  @@index([applicationId])
  @@map("ai_resume_analyses")
}

model AiGeneratedQuestionSet {
  id         String   @id @default(uuid())
  orgId      String
  jobId      String
  role       String?
  difficulty String?
  roundType  String?
  status     String   @default("draft")
  questions  Json
  createdAt  DateTime @default(now())

  @@index([orgId])
  @@index([jobId])
  @@map("ai_question_sets")
}

model AiFeedbackSummary {
  id                       String   @id @default(uuid())
  orgId                    String
  interviewId              String
  candidateId              String
  summary                  String
  strengths                String[]
  weaknesses               String[]
  riskNotes                String[]
  finalRecommendationDraft String?
  createdAt                DateTime @default(now())

  @@index([interviewId])
  @@map("ai_feedback_summaries")
}

model AiUsageLog {
  id           String   @id @default(uuid())
  orgId        String
  userId       String?
  featureName  String
  provider     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  status       String
  latencyMs    Int?
  createdAt    DateTime @default(now())

  @@index([orgId])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

model Payment {
  id             String   @id @default(uuid())
  organizationId String
  planId         String
  orderId        String   @unique
  paymentId      String?
  webhookEventId String?  @unique
  amount         Decimal  @db.Decimal(10, 2)
  currency       String   @default("INR")
  status         String   @default("created")
  pdfUrl         String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@map("payments")
}

model Subscription {
  id               String    @id @default(uuid())
  organizationId   String    @unique
  planId           String
  status           String    @default("trial")
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([organizationId])
  @@map("subscriptions")
}

model AuditLog {
  id           String   @id @default(uuid())
  orgId        String
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([orgId, createdAt])
  @@map("audit_logs")
}
